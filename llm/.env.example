# Database Configuration
DB_PATH=smart_llm.db
DB_BACKUP_PATH=backups/

# Model Configuration
MODEL_NAME=t5-small
USE_ADVANCED=true
MAX_MODEL_SIZE_MB=2000

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=false

# File System Configuration
LOG_DIR=logs/
CACHE_DIR=cache/

# Default Values
DEFAULT_CONTEXT_LENGTH=1024
DEFAULT_TEMPERATURE=0.7
DEFAULT_MAX_TOKENS=100

# SQL Configuration
SQL_TIMEOUT_SECONDS=30
SQL_MAX_ROWS=1000

# Advanced Options
ENABLE_STREAMING=true
ENABLE_CACHING=true
CACHE_TTL_SECONDS=3600
